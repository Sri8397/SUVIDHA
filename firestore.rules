rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_directory/{phoneNumber} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneNumber == phoneNumber
        && request.auth.token.phone_number == phoneNumber;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /user_profiles/{userId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.phoneNumber == request.auth.token.phone_number;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /shared_splits/{splitId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid || request.auth.uid == resource.data.recipientUid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['ownerUid', 'recipientUid', 'amount', 'note', 'date', 'contentHash', 'isSettled', 'settledAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'recipientUid', 'amount', 'note', 'date', 'contentHash', 'isSettled', 'settledAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.note is string
        && request.resource.data.date is int
        && request.resource.data.contentHash is string
        && request.resource.data.contentHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.isSettled is bool
        && exists(/databases/$(database)/documents/user_profiles/$(request.resource.data.recipientUid));
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSettled', 'settledAt'])
            && request.resource.data.isSettled == true)
          || (!resource.data.keys().hasAny(['contentHash'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contentHash'])
            && request.resource.data.contentHash is string
            && request.resource.data.contentHash.matches('^[0-9a-f]{64}$'))
        );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
